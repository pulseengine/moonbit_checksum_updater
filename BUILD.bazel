# MoonBit Checksum Updater Build Configuration
#
# Architecture:
#   lib/         - Shared core library (pure logic, no I/O)
#   cmd/native/  - Native backend (moon build)
#   cmd/wasi/    - WASI backend (Bazel + wit-bindgen)

load("@rules_moonbit//moonbit:defs.bzl", "moonbit_library")
load("@rules_wasm_component//moonbit:defs.bzl", "moonbit_wasm_cli")

package(default_visibility = ["//visibility:public"])

# ============================================================================
# Core Library
# ============================================================================
# Shared pure logic: types, validation, JSON parsing, version comparison,
# checksum management, and update orchestration.

moonbit_library(
    name = "checksum_core",
    srcs = [
        "lib/types.mbt",
        "lib/errors.mbt",
        "lib/traits.mbt",
        "lib/json_utils.mbt",
        "lib/validation.mbt",
        "lib/version_utils.mbt",
        "lib/checksum_manager.mbt",
        "lib/retry.mbt",
        "lib/update_engine.mbt",
    ],
)

# ============================================================================
# WASI CLI (Full WASI Bindings via wit-bindgen)
# ============================================================================
# Builds a WASM Component that exports wasi:cli/run.
# Run with: wasmtime run checksum_updater_wasi.wasm <COMMAND>

moonbit_wasm_cli(
    name = "checksum_updater_wasi",
    srcs = ["cmd/wasi/main.mbt"],
)
