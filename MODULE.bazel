# MoonBit Checksum Updater Module
#
# This project builds a WASM component CLI tool for updating checksums.
# It uses:
# - rules_moonbit: MoonBit language compilation
# - rules_wasm_component: WASM Component Model wrapping with WASI support

bazel_dep(name = "rules_moonbit", version = "0.1.0")
bazel_dep(name = "rules_wasm_component", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# Git overrides for CI compatibility (not in BCR yet)
git_override(
    module_name = "rules_moonbit",
    remote = "https://github.com/pulseengine/rules_moonbit.git",
    commit = "1861c8a8525c1d92c47bf12cfc3942ac38682509",
)

git_override(
    module_name = "rules_wasm_component",
    remote = "https://github.com/pulseengine/rules_wasm_component.git",
    commit = "dc857cfca85c8e079137aa66c8bdce9553c2ff42",  # main branch
)

# Use the MoonBit toolchain extension
moonbit = use_extension("@rules_moonbit//moonbit:extensions.bzl", "moonbit_toolchain_extension")
use_repo(moonbit, "moonbit_toolchain")

# Register the hermetic toolchain
register_toolchains("@moonbit_toolchain//:moonbit_toolchain")
